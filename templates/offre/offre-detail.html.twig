{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Offre - Web4All
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('offre-detail.css') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('offre-detail.js') }}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}  {# Import les éléments du header ( Image |Titre |Image) #}
{% endblock %}

{% block main %}

    <section class="offre-container">
        <!-- Section Hero -->
        <div class="offre-hero">
            <div class="offre-hero-content">
                <div class="offre-header-info">
                    <h1 class="offre-titre">
                        {% if offre %}
                            {{ offre['Nom'] ?? 'Offre d\'emploi' }}
                        {% else %}
                            Offre d'emploi
                        {% endif %}
                    </h1>
                    <p class="offre-meta">
                        {% if offre and offre['Date_debut'] %}
                            Publiée le {{ offre['Date_debut']|date('d/m/Y') }}
                        {% else %}
                            Publiée le {{ 'now'|date('d/m/Y') }}
                        {% endif %}
                    </p>
                    {% if entreprise %}
                        <p class="offre-entreprise">
                            <strong>Entreprise :</strong> {{ entreprise['Nom'] ?? 'Non spécifiée' }}
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Section Informations principales -->
        <div class="offre-info-section">
            <div class="offre-dates">
                <div class="date-item">
                    <span class="date-label">Début :</span>
                    <span class="date-value">
                        {% if offre and offre['Date_debut'] %}
                            {{ offre['Date_debut']|date('d/m/Y') }}
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Fin :</span>
                    <span class="date-value">
                        {% if offre and offre['Date_fin'] %}
                            {{ offre['Date_fin']|date('d/m/Y') }}
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Durée (Jours) :</span>
                    <span class="date-value">
                        {% if offre and offre['Duree'] %}
                            {{ offre['Duree'] }} jours
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Rémunération (€):</span>
                    <span class="date-value">
                        {% if offre and offre['Renumeration'] %}
                            {{ offre['Renumeration']|number_format(2, ',', ' ') }} €
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
            </div>

            <div class="offre-badges">
                <span class="badge">
                    {% if offre %}
                        Offre active
                    {% else %}
                        Nouvelle offre
                    {% endif %}
                </span>
            </div>
        </div>

        <!-- Section Description -->
        <div class="offre-description-section">
            <div class="offre-description-content">
                <h2>Description de l'offre</h2>
                <div class="offre-description-text">
                    {% if offre and offre['Descriptif'] %}
                        {{ offre['Descriptif']|nl2br }}
                    {% else %}
                        <p>Aucune description disponible pour cette offre.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Section Actions -->
        <div class="offre-actions-section">
            {% if offre %}
                <!-- DEBUG: Id offre = {{ offre['Id_offre'] }} -->
                <a href="/offre/{{ offre['Id_offre'] }}/postuler" class="offre-btn offre-btn-primary" id="test-postuler">
                    <span class="btn-icon">📧</span>
                    Postuler
                </a>
            {% else %}
                <button class="offre-btn offre-btn-primary" id="btn-postuler" disabled>
                    <span class="btn-icon">📧</span>
                    Postuler
                </button>
            {% endif %}
            <button class="offre-btn offre-btn-secondary" id="btn-wishlist">
                <span class="btn-icon">❤️</span>
                Ajouter à la wishlist
            </button>
            <button class="offre-btn offre-btn-outline" id="btn-partager">
                <span class="btn-icon">🔗</span>
                Partager
            </button>
        </div>

        <!-- Section Retour -->
        <div class="offre-back-section">
            <a href="{{ path('MesOffres') }}" class="offre-back-link">
                ← Retour aux offres
            </a>
        </div>
    </section>

    <!-- Meta data pour JS -->
    <div id="offre-data" 
         {% if offre %}data-offre-titre="{{ offre['Nom'] }}" data-offre-id="{{ offre['Id_offre'] }}"{% endif %}
         style="display:none;">
    </div>
{% endblock %}

{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}
