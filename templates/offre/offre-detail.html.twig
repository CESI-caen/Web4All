{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Offre - Web4All
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('offre-detail.css') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('offre-detail.js') }}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}  {# Import les éléments du header ( Image |Titre |Image) #}
{% endblock %}

{% block main %}

    <section class="offre-container">
        <!-- Section Hero -->
        <div class="offre-hero">
            <div class="offre-hero-content">
                <div class="offre-header-info">
                    <h1 class="offre-titre">
                        
                            {{offre.Nom}}
                     
                    </h1>
                    <p class="offre-meta">Publiée le {{ 'now'|date('d/m/Y') }}</p>
                </div>
            </div>
        </div>

        <!-- Section Informations principales -->
        <div class="offre-info-section">
            <div class="offre-dates">
                <div class="date-item">
                    <span class="date-label">Début :</span>
                    <span class="date-value">
                      
                            {{offre.Date_debut|date('d/m/Y')}}
                        
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Fin :</span>
                    <span class="date-value">
                        
                            {{offre.Date_fin|date('d/m/Y')}}
                        
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Durée (Jours) :</span>
                    <span class="date-value">
                       
                           {{ (offre.Date_fin|date('U') - offre.Date_debut|date('U')) // 86400 }}
                        
                    </span>
                </div>
            <div class="date-item">
                    <span class="date-label">Rémunération (€):</span>
                    <span class="date-value">
                        
                           {{ offre.Renumeration }} €
                        
                    </span>
                </div>
            </div>

        </div>

        <!-- Section Description -->
        <div class="offre-description-section">
            <div class="offre-description-content">
                <h2>Description</h2>
                <div class="offre-description-text">
                    <p>
                        {{ offre.Descriptif }} €
                    </p>
                </div>
            </div>
        </div>
        <div class="offre-actions-section">
        {% if user and user.id != 999 and user.nom_type_compte == 'etudiant' %}
        <!-- Section Actions -->
        
            <button class="offre-btn offre-btn-primary" onclick="document.getElementById("btn_Postuler").click()">
                <span class="btn-icon">📧</span>
                <a href="{{ path('Postuler') }}" id="btn_Postuler">Postuler</a>
            </button>
            <button class="offre-btn offre-btn-secondary" onclick="">
                <span class="btn-icon">❤️</span>
                <a href="{{ path('Wishlist_ajout', {'id': offre.Id_offre}) }}" id="btn_wishlist">Wishlist</a>
            </button>
            {% endif %}
            <button class="offre-btn offre-btn-secondary" onclick="">
                <span class="btn-icon">❤️</span>
                <a href="{{ path('AvisOffre', {'id': offre.Id_offre}) }}" id="btn_avis">Avis</a>
            </button>
        </div>
        

    {% for note in notes %} {#Selon ordre BDD#}
        <div id="offres" style="background-color: var(--color-bg-container);">
        <h2>Commentaires : </h2>
        <P>Note : {{note.Note}}</p>
        <P>Commentaire : {{note.Commentaire}}</p>
        <p>Posté par : {{note.Nom}} {{note.Prenom}}</p>
    </div>
    {% endfor %}
    
    </section>
    
{% endblock %}

{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}
