{% extends 'components/base.html.twig' %}


{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('avis-offre.css') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('avis-offre.js') }}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}


{% block main %}

    <form action="" method="post">
        <div>
            <label>Titre de l'offre :
                <select> #TODO : remplacer par une liste d'offres réelles de la bdd 
                    <option value="">Sélectionner</option>
                    <option value="Homme">Homme</option>
                    <option value="Femme">Femme</option>
                    <option value="Autre">Autre</option>
                </select>
            </label>
        </div>

        <div>
            <label for="commentaire">Commentaire sur L'offre</label>
            <textarea name="comment" id="commentaire" maxlength="450" required></textarea>
        </div>
        
        <div class="stars">
            <label for="commentaire" class="startext">Note</label>
            <div class="star" data-value="1"><img src="{{asset('build/images/icons_étoile.png')}}" alt="Etoile"></div>
            <div class="star" data-value="2"><img src="{{asset('build/images/icons_étoile.png')}}" alt="Etoile"></div>
            <div class="star" data-value="3"><img src="{{asset('build/images/icons_étoile.png')}}" alt="Etoile"></div>
            <div class="star" data-value="4"><img src="{{asset('build/images/icons_étoile.png')}}" alt="Etoile"></div>
            <div class="star" data-value="5"><img src="{{asset('build/images/icons_étoile.png')}}" alt="Etoile"></div>
        </div>
        <input type="hidden" name="note" id="note" value="0">
        <button type="submit">Valider</button>
    </form>

{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

