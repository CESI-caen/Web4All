{% extends 'components/base.html.twig' %}



{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
    {{ encore_entry_link_tags('barre-de-recherche') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('index.js') }}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}
    {{ include('home/header-home.html.twig')}}
{% endblock %}


{% block main %}
    <div id="MenuPannel" class="menu-panel" hidden> 
        <!-- Profil -->
        <div class="menu-item">
            <button > Nom Prénom</button>
        </div>

        <a href="{{ path('Profil') }}"> <div class="menu-item">
            <button > Profils </button>
        </div> </a>

        <a href="{{ path('Fichier Personnels') }}"> <div class="menu-item">
            <button > Fichier personnels </button>
        </div> </a>

        <div class="menu-item">
            <button > Création de compte Etudiant Si Pilote scolaire</button>
        </div>

       <a href="{{ path('Paramètres') }}"> <div class="menu-item">
            <button > Paramètres </button>
        </div> </a>
       <a href="{{ path('WishList') }}"> <div class="menu-item-pc">
            <button >  Wishlist </button>
        </div> </a> 
        <div class="menu-item-pc">
            <button > Recherche </button>
        </div>
        
        <div class="menu-item">
            <button > Déconnexion </button>
        </div>
    </div>
        {# {{ include("components/barre-recherche.html.twig") }} #}

        <div id="NotificationPannel" class="notif-pannel" style = "grid-area: notification" hidden> 
            <h1>Notifications</h1>
            <div class="notif-item">
                <button > Notification selon bdd</button>
                {% for offre in 0..3 %}
                <div name="Bulle-Offre" class="offre-item">
                    <head>
                        <p class="bulle-offre-titre">Offre {{offre}}</p>
                        <p class="bulle-offre-dates">01/01 -> 01/03 2026</p>
                    </head>
                    <hr>
                    <div class="bulle-offre-detail">
