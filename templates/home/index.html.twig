{% extends "base.html.twig" %}


{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('index.js') }}
{% endblock %}


{% block header %}
    <div class="header-container">
    
    <button class="mobile-nav-button" onclick="toggleMenu()">
        <img src="{{ asset('build/images/icon_burger_menu.png')}}" alt="Menu">
    </button>

    <button class="mobile-nav-button"> <div class="header-title"><a href="/">{{ page_title }}</a></div> </button>

    <button class="mobile-nav-button" onclick="toggleNotif()">
        <img src="{{ asset('build/images/icon_notification.png')}}" alt="Notification">
    </button>
</div>

{% endblock %}


{% block body %}
    <main>

    <div id="MenuPannel" class="menu-panel" hidden> 
        <!-- Profil -->
        <div class="menu-item">
            <button > Nom Prénom</button>
        </div>

        <div class="menu-item">
            <button > Profil</button>
        </div>

        <div class="menu-item">
            <button > Fichiers personnels</button>
        </div>

        <div class="menu-item">
            <button > Création de compte Etudiant Si Pilote scolaire</button>
        </div>

        <div class="menu-item">
            <button ><a href="/parametres"> Paramètres </a></button>
        </div>
        <div class="menu-item-pc">
            <button > Whishlist </button>
        </div>
        <div class="menu-item-pc">
            <button > Recherche </button>
        </div>
        <div class="menu-item">
            <button > Déconnexion </button>
        </div>
    </div>

        <div id="NotificationPannel" class="notif-pannel" style = "grid-area: notification" hidden> 
            <h1>Notifications</h1>
            <div class="notif-item">
                <button > Notification selon bdd</button>
            </div>
        </div>

        <div id="ContainerPannel" name="Container-Offres" class="offre-container" >
            {# foreach offre in offres && offre<24h(recent) → afficher les info de offre #}

            {% for offre in 0..3 %}
                <div name="Bulle-Offre" class="offre-item">
                    <head>
                        <p class="bulle-offre-titre">Offre {{offre}}</p>
                        <p class="bulle-offre-dates">01/01 -> 01/03 2026</p>
                    </head>
                    <hr>
                    <div class="bulle-offre-detail">
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc congue volutpat elit non congue. Curabitur at sodales sem, nec condimentum sapien. Ut pretium interdum nibh, a rhoncus eros accumsan a. Suspendisse potenti. Nam libero magna, volutpat sed lorem eget, vestibulum porttitor dolor. Mauris erat lacus, imperdiet vitae velit a, feugiat.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
        
    </main>
{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

