{% extends 'components/base.html.twig' %}



{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
    {{ encore_entry_link_tags('barre-de-recherche') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}
    {{ include('home/header-home.html.twig')}}  {# Import les éléments du header ( Image |Titre |Image) #}
{% endblock %}


{% block main %}

    {% include('components/menu-burger.html.twig') %}  {# Import les éléments du menu burger #}

        <div id="ContainerPannel" class="offre-container" >
            {# foreach offre in offres && offre<24h(recent) → afficher les info de offre #}
           {# {{ include("components/barre-recherche.html.twig") }} #} 
            {% for offre in offres %}
                <div class="offre-item">
                    <header>
                        
                        <p class="bulle-offre-titre"><a href="{{ path('Offre', {'id': offre.Id_offre}) }}" > {{ offre.Nom }} </a></p>
                        <p class="bulle-offre-dates">{{offre.Date_debut}} -> {{offre.Date_fin}}</p>
                    </header>
                    <hr>
                    <div class="bulle-offre-detail">
                        <p>{{offre.Descriptif}}</p>
                    </div>
                </div>
                
            {% endfor %}
            {% if nbpages > 1 %}
        <div class="pagination">
            <input type="button"
                   value="Précédent"
                   onclick="window.location.href='?page={{ max(page - 1, 1) }}'"
                   class="btn">
            {% if page == 1 %}
                <strong>1...</strong>
            {% else %}
                <a href="{{ baseUrl }}?page=1">1...</a>
            {% endif %}
            {% for i in (page - 2)..(page + 2) %}
                {% if i > 1 and i < nbpages %}
                    {% if i == page %}
                        <strong>{{ i }}</strong>
                    {% else %}
                        <a href="{{ baseUrl }}?page={{ i }}">{{ i }}</a>
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% if page == nbpages %}
                <strong>...{{ nbpages }}</strong>
            {% else %}
                <a href="{{ baseUrl }}?page={{ nbpages }}">...{{ nbpages }}</a>
            {% endif %}
            <input type="button"
                   value="Suivant"
                   onclick="window.location.href='?page={{ min(page + 1, nbpages) }}'"
                   class="btn">
        </div>
    {% endif %}
        </div>
{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

