{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Mes Offres
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('mes-offres.css') }}
    {{ encore_entry_link_tags('header') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}

{% block main %} 
    <section class="container">
        <div class="btn-Create">
            Créer une offre
        </div>
        <div class="Offres">
            {% for i in 1..5 %}
            <div class="Offre">
                <img id="offre-image" src="{{ asset('build/images/image.png') }}">
                <div class="content">
                    <p class="title">Nom Recruteur</p>
                    <p class="subtitle">Nom de l'offre</p>
                </div>
                <div class="Offre-btn">
                    <div class="Offre-btn-Edit">
                    <div class="icon">
                        <img src="{{ asset('build/images/editer.png') }}" alt="edit">
                    </div>
                    <div class="text">
                        Editer
                    </div>
                    </div>
                    <div class="Offre-btn-Delete">
                    <div class="icon">
                        <img src="{{ asset('build/images/croix.png') }}" alt="delete">
                    </div>
                    <div class="text">
                        Supprimer
                    </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block footer %}
{% endblock %}