{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    WishList
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('wishlist.css') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('wishlist.js') }}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}

{% block main %}
    <section class="container">
    {% for Wishlist in Wishlists %}
        <div class="item">
            <img class="pp" src="{{ asset('build/images/image.png') }}" alt="photo">

            <div class="content">
                <p class="title">{{ Wishlist.Nom_Utilisateur }} {{ Wishlist.Prenom_Utilisateur }}
                <p class="title">{{ Wishlist.Nom_Entreprise}}</p>
                <p class="subtitle">{{ Wishlist.Nom_Offre }}</p>
            </div>

            <div class="actions">
                <img class="plus icon" src="{{ asset('build/images/plus.png') }}" alt="plus">
                <img class="heart icon" src="{{ asset('build/images/coeur.png') }}" alt="heart">
            </div>
        </div>
    {% endfor %}
    </section>
{% endblock %}

{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}