{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Offre - Web4All
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('offre-detail.css') }}
    {{ encore_entry_link_tags('header') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('offre-detail.js') }}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    <div class="header-container">
        <button class="mobile-nav-button">
            <div class="header-title">
                <a href="{{ path('Home') }}"><img class="icon" src="{{asset('build/images/icon_return.png')}}" alt="Retour"></a>
            </div>
        </button>

        <button class="mobile-nav-button">
            <div class="header-title">
                <a href="{{ path('MesOffres') }}">Retour aux offres</a>
            </div>
        </button>

        <button class="mobile-nav-button" onclick="toggleNotif()">
            <img class="icon" src="{{ asset('build/images/icon_notification.png')}}" alt="Notification">
        </button>
    </div>
{% endblock %}

{% block main %}
    <section class="offre-container">
        <!-- Section Hero -->
        <div class="offre-hero">
            <div class="offre-hero-content">
                <div class="offre-header-info">
                    <h1 class="offre-titre">
                        {% if offre.entreprise and offre.entreprise.nom %}
                            {{ offre.entreprise.nom }}
                        {% else %}
                            Offre d'emploi
                        {% endif %}
                    </h1>
                    <p class="offre-meta">Publiée le {{ 'now'|date('d/m/Y') }}</p>
                </div>
            </div>
        </div>

        <!-- Section Informations principales -->
        <div class="offre-info-section">
            <div class="offre-dates">
                <div class="date-item">
                    <span class="date-label">Début :</span>
                    <span class="date-value">
                        {% if offre.dateDebut %}
                            {{ offre.dateDebut|date('d/m/Y') }}
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Fin :</span>
                    <span class="date-value">
                        {% if offre.dateFin %}
                            {{ offre.dateFin|date('d/m/Y') }}
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
                <div class="date-item">
                    <span class="date-label">Durée (Jours) :</span>
                    <span class="date-value">
                        {% if offre.duree %}
                            {{ offre.duree }}
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
            <div class="date-item">
                    <span class="date-label">Rémunération (€):</span>
                    <span class="date-value">
                        {% if offre.renumeration %}
                            {{ offre.renumeration }}
                        {% else %}
                            À définir
                        {% endif %}
                    </span>
                </div>
            </div>

            <div class="offre-badges">
                <span class="badge">Nouvelle offre</span>
            </div>
        </div>

        <!-- Section Description -->
        <div class="offre-description-section">
            <div class="offre-description-content">
                <h2>Description de l'offre</h2>
                <div class="offre-description-text">
                    {% if offre.descriptif %}
                        {{ offre.descriptif|nl2br }}
                    {% else %}
                        <p>Aucune description disponible pour cette offre.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Section Actions -->
        <div class="offre-actions-section">
            <button class="offre-btn offre-btn-primary" id="btn-postuler">
                <span class="btn-icon">📧</span>
                Postuler
            </button>
            <button class="offre-btn offre-btn-secondary" id="btn-wishlist">
                <span class="btn-icon">❤️</span>
                Ajouter à la wishlist
            </button>
            <button class="offre-btn offre-btn-outline" id="btn-partager">
                <span class="btn-icon">🔗</span>
                Partager
            </button>
        </div>

        <!-- Section Retour -->
        <div class="offre-back-section">
            <a href="{{ path('MesOffres') }}" class="offre-back-link">
                ← Retour aux offres
            </a>
        </div>
    </section>

    <!-- Meta data pour JS -->
    <div id="offre-data" 
         data-offre-id="{{ offre.idOffre }}"
         data-offre-titre="Offre"
         style="display:none;">
    </div>
{% endblock %}
