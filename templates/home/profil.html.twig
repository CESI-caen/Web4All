{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Profil
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('profil') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}

{% block javascripts %}{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}

{% block main %} 
    <section class="container">
        
        <div id="photo-profil">
            <img src="{{ asset('build/images/louis.jpg')}}" alt="photo de profil">
            <p>Modifier la photo de profil</p>
        </div>

        <div id="data">
            <form method="post">
                <label>Nom :<br>
                    <input type="text" name="nom" value="Nom"> {# a remplacer par les valeurs de la bdd dans value#}
                </label><br><br>

                <label>Prénom :<br>
                    <input type="text" name="prenom" value="Prénom">
                </label><br><br>

                <label>Genre :<br>
                    <input type="text" name="genre" value="Genre">
                </label><br><br>

                <label>Ville :<br>
                    <input type="text" name="ville" value="Ville">
                </label><br><br>

                <label>Description :</label><br>
                <textarea id="Description" name="Description" rows="5" placeholder="Écrivez votre description ici..."></textarea>

                <br><br>
                <button type="submit">mettre a jour</button>
            </form>
        </div>

    </section>
{% endblock %}

{% block footer %}
    {{ include('components/footer.html.twig') }}
{% endblock %}