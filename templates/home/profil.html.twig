{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Profil
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('profil') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}

{% block main %} 
    <section class="container">
        
        <div id="photo-profil">
            <img src="{{ asset('build/images/image.png') }}" alt="photo de profil">
            <p>Modifier la photo de profil</p>
        </div>

        <div id="data">
            <form method="post" action="{{ path('Profil') }}">
                <label>Nom :<br>
                    <input type="text" name="nom" value={{ nom}} required>

                <label>Prénom :<br>
                    <input type="text" name="prenom" value={{ prenom}} required>
                </label><br><br>

                <label>Genre :<br>
                    <select name="genre" required>
                        <option value="Homme" {% if genre == 'Homme' %}selected{% endif %}>Homme</option>
                        <option value="Femme" {% if genre == 'Femme' %}selected{% endif %}>Femme</option>
                        <option value="Autre" {% if genre == 'Autre' %}selected{% endif %}>Autre</option>
                    </select>
                </label><br><br>

                <label class="titre">Ville<br>
                <input name="ville" type="text" placeholder="Ville" value={{ ville}} required>
                </label><br><br>

                <label class="groupe">
                <span id="labelGroupe">{% if type_compte == 1 %}Entreprise{% else %}École{% endif %}</span><br>
                {% if type_compte == 1 %}<input id="inputGroupe" name="groupe" type="text" value={{ groupe}} required readonly>{% else %}<input id="inputGroupe" name="groupe" type="text" value={{ groupe}} required>{% endif %}
                </label><br>

                <br>
                <label class="email">Email<br>
                <input name="email" type="email" value = {{ email}} required>
                </label><br><br>

                <br>
                <button type="submit">mettre a jour</button>
            </form>
        </div>

    </section>
{% endblock %}

{% block footer %}
    {{ include('components/footer.html.twig') }}
{% endblock %}