{% extends 'components/base.html.twig' %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block title %}
    Profil
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('profil') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}

{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}

{% block main %} 
    <section class="container">
        
        <div id="photo-profil">
            <img src="{{ asset('build/images/image.png') }}" alt="photo de profil">
            <p>Modifier la photo de profil</p>
        </div>

        <div id="data">
            <form method="post">
                <label>Nom :<br>
                    <input type="text" name="nom" value="Nom" required> {# a remplacer par les valeurs de la bdd dans value#}
                </label><br><br>

                <label>Prénom :<br>
                    <input type="text" name="prenom" value="Prénom" required>
                </label><br><br>

                <label>Genre :<br>
                    <select>
                        <option value="Homme">Homme</option>
                        <option value="Femme">Femme</option>
                        <option value="Autre">Autre</option>
                    </select>
                </label><br><br>

                <label>Description :</label><br>
                <textarea id="Description" name="Description" rows="5" placeholder="Écrivez votre description ici..."></textarea>

                <br><br>

                <label class="titre">Ville<br>
                <input name="ville" type="text" placeholder="Ville" required>
                </label><br><br>

                <label class="groupe">
                <span id="labelGroupe">École</span><br>
                <input id="inputGroupe" name="groupe" type="text" placeholder="École" required>
                </label><br>

                <br>
                <label class="email">Email<br>
                <input name="email" type="email" value = "email" required>
                </label><br><br>

                <br>
                <button type="submit">mettre a jour</button>
            </form>
        </div>

    </section>
{% endblock %}

{% block footer %}
    {{ include('components/footer.html.twig') }}
{% endblock %}