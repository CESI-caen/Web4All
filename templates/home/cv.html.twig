{% extends 'components/base.html.twig' %}


{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('cv') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}
    {{ include('components/header.html.twig')}}
    
{% endblock %}


{% block main %}
    {% if user and user.id != 999 and user.nom_type_compte == 'etudiant' %}
    <section class="container">
        <!-- CV -->
        <form action="{{ path('upload') }}" method="post" enctype="multipart/form-data">
        <h2> Upload de votre CV </h2>
            <div class="boite-upload">
            
                <input type="file" name="file" accept=".pdf">
                <input type="hidden" name="type" value="cv">                
                <img class="icon" src="{{asset('build/images/icon_file.png')}}" onclick="document.getElementById('input-cv').click()" alt="Fichier">
            </div>
            <br>
            <button class="bouton-a" id="Upload" type="submit">Upload Cv</button>
        </form>

        <p>{{message}} </p>
    </section> 
    {% else %}
        <p style="color:red; text-align:center;">Vous n'avez pas la permission d'accéder à cette page.</p>
    {% endif %} 
{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

