

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<h1>Liste des utilisateurs</h1>

{% if users %}
    <ul>
        {% for user in users %}
            <li>
                <a href="{{ path('user_show', {'id': user.Id_utilisateur}) }}">
                    {{ user.Nom }} ({{ user.Email }})
                </a>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>Aucun utilisateur trouvé</p>
{% endif %}
{% endblock %}