<div class="header-container">
    {% block boutton_gauche %}
        <button class="mobile-nav-button">
            <div class="header-title">

                {% if userId %}
                    {% set route = ancien_page_title %}
                    {% set id = null %}

                    {% if entreprise is defined %}
                        {% set id = entreprise.Id_entreprise %}
                    {% elseif offre is defined %}
                        {% set id = offre.Id_offre %}
                    {% elseif offre_id is defined %}
                        {% set id = offre_id %}
                    {% endif %}

                    <a href="{{ id ? path(route, {id: id}) : path(route) }}">
                        <img class="icon" src="{{ asset('build/images/icon_return.png') }}" alt="Retour">
                    </a>
                {% else %}
                    <a href="{{ path('Login') }}">
                        <img class="icon" src="{{ asset('build/images/icon_return.png') }}" alt="Retour">
                    </a>
                {% endif %}

            </div>
        </button>
    {% endblock %}

    <button class="mobile-nav-button">
        <div class="header-title">

            {% if userId %}
                {% set route = page_title %}
                {% set id = null %}

                {% if entreprise is defined %}
                    {% set id = entreprise.Id_entreprise %}
                {% elseif offre is defined %}
                    {% set id = offre.Id_offre %}
                {% elseif offre_id is defined %}
                    {% set id = offre_id %}
                {% endif %}

                <a href="{{ id ? path(route, {id: id}) : path(route) }}">
                    {{ page_title }}
                </a>
            {% else %}
                <a href="{{ path('Login') }}">{{ page_title }}</a>
            {% endif %}

        </div>
    </button>

    {% block boutton_droite %}
        <button class="mobile-nav-button"></button>
    {% endblock %}
</div>