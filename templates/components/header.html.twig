<div class="header-container">
    {% block boutton_gauche %}
        <button class="mobile-nav-button">
            <div class="header-title">
                {% if userId %}
                    {% if ancien_page_title == 'Offre' or ancien_page_title == 'AvisOffre' %}
                        {% if offre_id is defined %}
                            <a href="{{ path(ancien_page_title, {id: offre_id}) }}"><img class="icon" src="{{asset('build/images/icon_return.png')}}" alt="Home"></a>
                        {% endif %}
                    {% else %}
                        <a href="{{ path(ancien_page_title)  }}"><img class="icon" src="{{asset('build/images/icon_return.png')}}" alt="Home"></a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('Login') }}"><img class="icon" src="{{asset('build/images/icon_return.png')}}" alt="Home"></a>
                {% endif %}
            </div>
        </button>
    {% endblock %}

    <button class="mobile-nav-button">
        <div class="header-title">
            {% if userId %}
                {% if page_title == 'Offre' or page_title == 'AvisOffre' %}
                    {% if offre_id is defined %}
                        <a href="{{ path(page_title, {id: offre_id}) }}">{{ page_title }}</a>
                    {% endif %}
                {% else %}
                    <a href="{{ path(page_title) }}">{{ page_title }}</a>
                {% endif %}
            {% else %}
                <a href="{{ path('Login') }}">{{ page_title }}</a>
            {% endif %}
        </div>
    </button>   

    {% block boutton_droite %}
        <button class="mobile-nav-button" ></button>
    {% endblock %}
</div>