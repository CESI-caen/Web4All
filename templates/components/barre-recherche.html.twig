<div class="barre-recherche">
        <div class='recherche-container'>
                <div class="boutton-recherche-3">
                        <label for="recherche-input">Rechercher</label>
                        <button type="submit">
                                <img src="{{ submit_icon | default( asset('build/images/icon_loupe.png') ) }}" alt="loupe_icone-lancer_recherche">
                        </button>
                </div>
                <input id="recherche-input" type="search" name="{{ input_name | default('recherche')}}" placeholder="{{ placeholder | default('…')}}">
        </div>
</div>