<div class="header-container">

    <button class="mobile-nav-button" onclick="toggleMenu()">
        <img src="{{ asset('build/images/icon_burger_menu.png')}}" alt="Menu">
    </button>

    <button class="mobile-nav-button"> <div class="header-title"><a href="/">Accueil</a></div> </button>

    <button class="mobile-nav-button" onclick="toggleNotif()">
        <img src="{{ asset('build/images/icon_notification.png')}}" alt="Notification">
    </button>

</div>

<script>
/*Script qui permet l'affichage ou non du men*/
function toggleMenu() {
    if (MenuPannel.hidden) {
        MenuPannel.hidden = false;
        NotificationPannel.hidden = true;
    } else {
        MenuPannel.hidden = true;
    }
}

function toggleNotif() {
    if (NotificationPannel.hidden) {
        NotificationPannel.hidden = false;
        MenuPannel.hidden = true; 
    } else {
        NotificationPannel.hidden = true;
    }
}
</script>

