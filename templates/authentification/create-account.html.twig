{% extends 'components/base.html.twig' %}

{% block title %}Create account{% endblock %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('authentification') }}
    {{ encore_entry_link_tags('create-account.css') }}
{% endblock %}

{% block javascripts %}
    {{encore_entry_script_tags('create-account.js')}}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}{% endblock %}

{% block main %}
    {% if page == 1 %}
    <section class="container">
        <h1>Welcome to Web4All ! </h1>
        <h2>Create an account</h2>
        <p>Enter your email to sign up for this app</p>
        {% if error is defined and error %}
            <div class="error">{{ error }}</div>
        {% endif %}
        <form method="POST" action="{{ path('create-account') }}"> 
            <label class="titre">Email<br>
                <input name="email" type="email" placeholder="email@domain.com" value="{{ email|e }}" required>
            </label>
            <br><br>
            <input type="hidden" name="page" value="2">
            <button class="bouton-a" id="continue" type="submit">Continue</button>
            <br><br>
        </form>
        <div class="divider">
            <span>or</span>
        </div>
        <h2>Already have an account ?</h2>
        <p>Click the button below to login</p>
    <button class="bouton-b" id="login">Login</button>
        <div class="divider">
            <span>or</span>
        </div>
        <h2>No account needed</h2>
        <p>You can continue as a guest.</p>
    <button class="bouton-b" id="guest">Continue as Guest</button>
    </section>
{% elseif page == 2 %}
    <section class="container">
        <h2>Inscription</h2>
        <form method="POST" action="{{ path('create-account') }}">
         <label class="titre">Nom<br>
         <input name="nom" type="text" placeholder="Nom" required>
         </label>
         <label class="titre">Prenom<br>
         <input name="prenom" type="text" placeholder="Prenom" required>
         </label>

         <label class="titre">Genre :<br>
                    <select name="genre"> 
                        <option value="Homme">Homme</option>
                        <option value="Femme">Femme</option>
                        <option value="Autre">Autre</option>
                    </select>
        </label><br>

         <label class="titre">Ville<br>
         <input name="ville" type="text" placeholder="Ville" required>
         </label>

         <label class="titre">Code Postal<br>
         <input name="cp" type="text" placeholder="Code Postal" required>
         </label>

         <label class="titre">Type de compte<br></label><br>
         <label class="switch">
            <input type="radio" name="account_type" value="pilote" checked>
            <span class="slider">Pilote</span>
        </label>
        <label class="switch">
            <input type="radio" name="account_type" value="recruteur">
            <span class="slider">Recruteur</span>
        </label>
        
        <br><br>
        <label class="groupe">
            <span id="labelGroupe">École</span><br>
            <input id="inputGroupe" name="ecole" type="text" placeholder="École" required>
        </label>
        <br><br>
        <div id="entreprise-info">
            <label class="titre"> Email de l'entreprise<br>
                <input name="Email-entreprise" type="text" placeholder="email@domain.com" required>
            </label>
            <label class="titre"> Telephone de l'entreprise<br>
                <input name="telephone-entreprise" type="tel" placeholder="telephone" required>
            </label>
            <label class="titre"> Description de l'entreprise<br>
                <input name="description-entreprise" type="text" placeholder="description" required>
            </label>
            <label class="titre"> Ville de l'entreprise<br>
                <input name="ville-entreprise" type="text" placeholder="ville" required>
            </label>
            <label class="titre"> Code postale de la ville de l'entreprise<br>
                <input name="cp-entreprise" type="text" placeholder="code postale" required>
            </label>
            <label class="titre"> Domaine d'activité<br>
                <input name="domaine[]" type="text" placeholder="Domaine d'activité" required>
                <div id="domaines-container"></div>
                <div id="add-domain-container">
                    <button class="bouton-a" type="button" id="add-domain">Ajouter un domaine</button>
                </div>
            </label>
        </div>
        <label class="email">Email<br>
        <input name="email" type="email" value = {{ email }} required>
        </label>
        <br><br>
        <label class="telephone">Téléphone<br>
        <input name="telephone" type="tel" placeholder="01 02 03 04 05" required>
        </label>
        <br>
        <label class="titre">Mot de passe<br>
         <input name="password" type="password" placeholder="Mot de passe" required>
         </label>
         <br>
         <label class="titre">Confirmation du mot de passe<br>
         <input name="password_confirm" type="password" placeholder="Confirmer le mot de passe" required>
         </label>
         <br>
         <div class="buttons">
            <label>
            <input type="hidden" name="page" value="1">
            <button formnovalidate class="bouton-b" id="annuler">Annuler</button>
            </label>
            <button class="bouton-a" id="terminer">Terminer</button>
            
        </div>
        </form>
    </section>
    
{% endif %}
{% endblock %}

{% block footer %}{% endblock %}
