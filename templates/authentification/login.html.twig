{% extends 'base.html.twig' %}

{% block title %}login{% endblock %}

{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('login') }}
{% endblock %}

{% block javascripts %}{% endblock %}


{% block header %}{% endblock %}

{% block body %}
    <section class = "container">
        <h1>Welcome to Web4All ! </h1>
        <form>
            <label class="titre">Email<br><input name="email" type="email" size="30" placeholder="email@domain.com" required ></label>
            <br><br>
            <label class="titre">Password<br><input name="password" type="password" size="30" placeholder="value" required ></label>
            <br>
            <button id="send" type="submit"></button hidden>
            <label class="button" for="send">Sign in</label>
            <br><br>
        </form>
        <div class="divider">
            <span>or</span>
        </div>
        

    </section>
{% endblock %}
