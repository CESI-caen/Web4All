{% extends 'components/base.html.twig' %}


{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('compte') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}


{% block main %}

<p>Tu es connecté en tant que {{ user.prenom }} {{ user.nom }}</p>
<p>Ton adresse email est {{ user.email }}</p>
<p> ton téléphone est {{ user.telephone }}</p>
<p> tu es {{user.nom_type_compte}}</p>
   
{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

