{% extends 'components/base.html.twig' %}


{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('settings') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}


{% block javascripts %}{% endblock %}


{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}


{% block main %}

   <div class="container">
    <!-- Section Affichage -->
    <div class="section">
        <div class="section-header">Affichage</div>
        <div class="item">
            <div class="item-label">Thème</div>
            <div class="theme-icons">
                <!-- Icône Soleil -->
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-12.37c-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41zm-12.37 12.37c-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41z"></path>
                </svg>
                <!-- Icône Lune -->
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Section Préférences générales -->
    <div class="section">
        <div class="section-header">Préférences générales</div>
        <div class="item">
            <div class="item-label">Langue</div>
            <div class="item-action"><div class="chevron"></div></div>
        </div>
        <div class="item">
            <div class="item-label">Langue de contenu</div>
            <div class="item-action"><div class="chevron"></div></div>
        </div>
    </div>

    <!-- Section Accès au compte -->
    <div class="section">
        <div class="section-header">Accès au compte</div>
        <div class="item">
            <div class="item-label">Adresse e-mail</div>
            <div class="item-action"><div class="chevron"></div></div>
        </div>
        <div class="item">
            <div class="item-label">Numéro de téléphone</div>
            <div class="item-action"><div class="chevron"></div></div>
        </div>
        <div class="item">
            <div class="item-label">Où vous vous êtes identifié(e)</div>
            <div class="item-action"><div class="chevron"></div></div>
        </div>
        <div class="item">
            <div class="item-label">Authentification a deux facteurs</div>
            <div class="item-action"><div class="chevron"></div></div>
        </div>
    </div>
</div>

   
{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

