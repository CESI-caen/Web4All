{% extends 'components/base.html.twig' %}


{% block head %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}


{% block title %}
    {{ page_title }}
{% endblock %}


{% block stylesheets %}
    {{ encore_entry_link_tags('palette') }}
    {{ encore_entry_link_tags('modifier-mdp') }}
    {{ encore_entry_link_tags('header') }}
    {{ encore_entry_link_tags('footer') }}
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('theme') }}
{% endblock %}


{% block header %}
    {{ include('components/header.html.twig')}}
{% endblock %}


{% block main %}
<form>
<label class="titre">Mot de passe actuel<br>
    <input name="current_password" type="password" placeholder="Mot de passe actuel" required>
</label>
<label class="titre">Nouveau mot de passe<br>
    <input name="password" type="password" placeholder="Nouveau mot de passe" required>
</label>
<label class="titre">Confirmation du nouveau mot de passe<br>
    <input name="password_confirm" type="password" placeholder="Confirmer le nouveau mot de passe" required>
</label>

<div class="buttons">
<button class="bouton-a" id="confirmer">Confirmer</button>
</div>
</form>
   
{% endblock %}


{% block footer %}
    {{ include('home/footer-home.html.twig')}}
{% endblock %}

